    {
      "name": "🔑 JWT Authentication",
      "description": "JWT token-based authentication. Run a login request first - the token is automatically saved and used by all other requests!",
      "item": [
        {
          "name": "1. Login as ADMIN ⭐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token received', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.expect(jsonData.token.length).to.be.greaterThan(50);",
                  "});",
                  "",
                  "// 🎯 AUTO-SAVE TOKEN - This is the magic!",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "pm.collectionVariables.set('currentUser', jsonData.username);",
                  "pm.collectionVariables.set('currentRole', jsonData.role);",
                  "",
                  "console.log('✅ Logged in as:', jsonData.username);",
                  "console.log('🎫 Role:', jsonData.role);",
                  "console.log('🔐 Token saved! All requests will now use this token.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "description": "Admin user"
                },
                {
                  "key": "password",
                  "value": "password",
                  "description": "Default password"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "🌟 START HERE! Login as admin and get JWT token.\n\nThe token is automatically saved to `{{jwtToken}}` and will be used by all other requests.\n\nCredentials: admin / password"
          }
        },
        {
          "name": "2. Login as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "pm.collectionVariables.set('currentUser', jsonData.username);",
                  "pm.collectionVariables.set('currentRole', jsonData.role);",
                  "",
                  "console.log('✅ Logged in as:', jsonData.username);",
                  "console.log('🎫 Role:', jsonData.role);",
                  "console.log('🔐 Token saved!');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "user",
                  "description": "Regular user"
                },
                {
                  "key": "password",
                  "value": "password",
                  "description": "Default password"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as regular user (ROLE_USER).\n\nCredentials: user / password"
          }
        },
        {
          "name": "3. Get Auth Info (Who Am I?)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Auth info retrieved', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "console.log('👤 Current User:', jsonData.username);",
                  "console.log('🎫 Authorities:', JSON.stringify(jsonData.authorities));",
                  "console.log('🔐 Auth Type:', jsonData.authType);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "description": "JWT token (auto-filled)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "info"]
            },
            "description": "Check your current authentication status.\n\nShows: username, roles, auth type"
          }
        },
        {
          "name": "4. Access ADMIN Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('Admin access granted', function() {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    console.log('✅ Admin endpoint accessible!');",
                  "} else if (pm.response.code === 403) {",
                  "    pm.test('Access denied (expected for non-admin)', function() {",
                  "        pm.response.to.have.status(403);",
                  "    });",
                  "    console.log('❌ Access denied - you need ROLE_ADMIN');",
                  "    console.log('💡 Run \"Login as ADMIN\" first!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/secure",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "secure"]
            },
            "description": "Admin-only endpoint. Requires ROLE_ADMIN.\n\n✅ Works if logged in as: admin\n❌ Fails if logged in as: user"
          }
        },
        {
          "name": "5. Access USER Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User endpoint accessible', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "console.log('✅ User endpoint accessible!');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/secure",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "secure"]
            },
            "description": "User endpoint. Requires ROLE_USER or ROLE_ADMIN.\n\n✅ Works for both admin and user"
          }
        }
      ]
    },
