{
  "info": {
    "name": "Spring Security Reference - Complete Testing Suite",
    "description": "Complete API collection with AUTOMATIC JWT token management. Login once and use the token across all requests automatically!\n\n## Quick Start\n1. Run 'JWT Auth > 1. Login as Admin' - token is saved automatically\n2. All other requests will use this token\n3. Switch users by running different login requests\n\n## Authentication Methods\n- JWT: Auto-saved tokens\n- JDBC: Basic Auth (database users)\n- LDAP: Basic Auth (directory users)\n- OAuth2: Browser-based flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentUser",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentRole",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('🔐 Request to:', pm.request.url.toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "🏥 Health & Public",
